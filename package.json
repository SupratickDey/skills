{
  "name": "rewrite-rs-skills",
  "version": "0.2.0",
  "private": true,
  "description": "The most comprehensive Rust agent skills for writing real, idiomatic Rust and porting code from other languages.",
  "homepage": "https://rewrite.rs",
  "repository": {
    "type": "git",
    "url": "https://github.com/rewrite-rs/skills"
  },
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "check": "node --test tests/*.test.mjs && node scripts/check-skills.mjs && node scripts/sync-plugin-version.mjs --check && node scripts/check-examples.mjs",
    "check-examples": "node scripts/check-examples.mjs",
    "check-skills": "node scripts/check-skills.mjs",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "check:install": "node scripts/check-plugin-install.mjs",
    "eval:list": "node scripts/evaluate.mjs list",
    "eval:run": "node scripts/evaluate.mjs run",
    "eval:judge": "node scripts/evaluate.mjs judge",
    "eval:report": "node scripts/evaluate.mjs report",
    "eval:claude": "claude plugin eval . --scaffold --allow-tools Bash Write Edit --no-publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0",
    "@types/node": "^24"
  }
}
